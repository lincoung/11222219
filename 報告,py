import math

def run_small_scale_test(group_name, ages, strength_matrix, target_fc):
    print("==========================================")
    print(f" 測試組別：{group_name}")
    print("==========================================")
    
    avg_strengths = []
    
    # 1. 計算各齡期平均強度
    for i in range(len(ages)):
        age = ages[i]
        trials = [trial[i] for trial in strength_matrix]
        mean_str = sum(trials) / len(trials)
        avg_strengths.append(mean_str)
        print(f"  * 齡期 {age:2d} 天 | 試體實測數據: {trials} | 平均強度: {mean_str:.2f} MPa")
    
    n = len(ages)
    
    # 2. 純 Python 實作對數成長模型反推: f(t) = b * ln(t) + a
    x_log = [math.log(a) for a in ages]
    y_log = avg_strengths
    
    sum_x = sum(x_log)
    sum_y = sum(y_log)
    sum_xy = sum(x * y for x, y in zip(x_log, y_log))
    sum_xx = sum(x ** 2 for x in x_log)
    
    b_log = (n * sum_xy - sum_x * sum_y) / (n * sum_xx - sum_x ** 2)
    a_log = (sum_y - b_log * sum_x) / n
    
    # 3. 純 Python 實作 ACI 209 雙曲線模型反推: f(t) = t / (alpha + beta * t)
    # 轉換線性化形式: t / f(t) = alpha + beta * t
    x_aci = ages
    y_aci = [age / str_v for age, str_v in zip(ages, avg_strengths)]
    
    sum_xa = sum(x_aci)
    sum_ya = sum(y_aci)
    sum_xaya = sum(x * y for x, y in zip(x_aci, y_aci))
    sum_xxa = sum(x ** 2 for x in x_aci)
    
    beta_aci = (n * sum_xaya - sum_xa * sum_ya) / (n * sum_xxa - sum_xa ** 2)
    alpha_aci = (sum_ya - beta_aci * sum_xa) / n
    
    print(f"\n  [反推方程式結果]")
    print(f"  - 對數模型: f(t) = {b_log:.4f} * ln(t) + {a_log:.4f}")
    print(f"  - ACI模型:  f(t) = t / ({alpha_aci:.4f} + {beta_aci:.4f} * t)\n" + "-"*42 + "\n")

